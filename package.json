{
  "name": "multi-agent-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-transform-types --loader ./test/ts-loader.mjs --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:macp": "node --experimental-transform-types --loader ./test/ts-loader.mjs test/integration/coordination-macp.integration.ts",
    "test:durable": "node --experimental-transform-types --loader ./test/ts-loader.mjs --test test/coordination-durable-*.test.ts test/coordination-checkpoint.test.ts test/coordination-execution-*.test.ts",
    "test:durable-execution": "node --experimental-transform-types --loader ./test/ts-loader.mjs --test test/coordination-durable-actions.test.ts test/coordination-durable-evidence.test.ts test/coordination-durable-execution.test.ts test/coordination-execution-*.test.ts test/coordination-durable-migration.test.ts test/coordination-durable-browser.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
